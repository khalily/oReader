# Dockerfile for Development with Hot Reload
# This file is used by docker-compose.yml for local development

# =============================================================================
# Development stage with hot-reload support
# =============================================================================
FROM golang:1.25-alpine AS development

# Install development tools
RUN apk add --no-cache \
    git \
    make \
    air \
    wget \
    bash \
    ca-certificates

WORKDIR /src

# Install air for hot reload (if not available via apk)
RUN go install github.com/air-verse/air@latest || true

# Copy go mod files
COPY go.mod go.sum ./

# Download dependencies
RUN go mod download

# Copy source code (mounted as volume in docker-compose)
COPY . .

# Build the application once to verify
RUN go build -o /tmp/oreader ./cmd/server

# Default command (overridden by docker-compose)
CMD ["air"]

# =============================================================================
# Frontend development stage (for running frontend separately)
# =============================================================================
FROM node:22-alpine AS frontend-dev

WORKDIR /web

# Copy package files
COPY web/package.json web/package-lock.json ./

# Install all dependencies (including dev)
RUN npm install

# Copy source
COPY web/ ./

# Expose Vite dev server port
EXPOSE 5173

# Start Vite dev server
CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0"]
