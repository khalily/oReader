# =============================================================================
# oReader Tool Versions - Single Source of Truth
# =============================================================================
# Update versions here. All Dockerfiles, CI, and local tooling read from here.
# After changing, run: make check-versions
#
# How it propagates:
#   Makefile:    include versions.env  →  docker compose receives env vars
#   Dockerfile:  ARG X_VERSION=...    →  default matches this file, overridable via --build-arg
#   CI:          workflow env vars    →  validated by scripts/check-versions.sh
# =============================================================================

GO_VERSION=1.25
NODE_VERSION=22
PYTHON_VERSION=3.11
MYSQL_VERSION=9.0
REDIS_VERSION=7
GOLANGCI_LINT_VERSION=v2.11.4
ALPINE_VERSION=3.21
PHPMYADMIN_VERSION=5.2
