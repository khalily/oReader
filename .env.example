# oReader Environment Configuration
# Copy this file to .env and fill in the values

# =============================================================================
# Required Configuration
# =============================================================================

# Database connection string
# Development: SQLite file path
# Production: MySQL connection string
# Example (SQLite): oreader.db
# Example (MySQL): mysql://user:password@localhost:3306/oreader
DATABASE_URL=oreader.db

# JWT secret key for token signing
# MUST be at least 32 characters (256 bits)
# Generate with: openssl rand -base64 32
JWT_SECRET_KEY=your-secret-key-change-me-in-production

# =============================================================================
# Optional Configuration (with defaults)
# =============================================================================

# Server configuration
# ENV: development or production (default: development)
ENV=development

# Server port (default: 8080)
PORT=8080

# Authentication settings
# JWT_ACCESS_TTL: Access token lifetime (default: 15m)
# JWT_REFRESH_TTL: Refresh token lifetime (default: 168h = 7 days)
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=168h

# RSS Feed Refresh settings
# REFRESH_INTERVAL: Background refresh interval (default: 15m)
REFRESH_INTERVAL=15m

# Rate Limiting
# RATE_LIMIT_ENABLED: Enable/disable rate limiting (default: true)
# RATE_LIMIT_REDIS_URL: Redis URL for distributed rate limiting (optional)
RATE_LIMIT_ENABLED=true
# RATE_LIMIT_REDIS_URL=redis://localhost:6379

# Logging
# LOG_LEVEL: Log level - debug, info, warn, error (default: info)
LOG_LEVEL=info

# =============================================================================
# OAuth Configuration (Optional - Reserved for future use)
# =============================================================================

# GitHub OAuth
# GITHUB_CLIENT_ID=your-github-client-id
# GITHUB_CLIENT_SECRET=your-github-client-secret

# =============================================================================
# Development Only
# =============================================================================

# CORS allowed origins (comma-separated, development only)
# CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# =============================================================================
# Paper Import Configuration (Optional)
# =============================================================================

# Paper converter gRPC service address
PAPER_GRPC_ADDR=localhost:50051

# Directory for uploaded PDF files
PAPER_UPLOAD_DIR=uploads/papers

# Maximum PDF upload size in bytes (default: 52428800 = 50MB)
PAPER_MAX_UPLOAD_SIZE=52428800

# gRPC client timeout (default: 5m)
PAPER_GRPC_TIMEOUT=5m
