# oReader Environment Configuration
# Copy this file to .env and fill in the values

# =============================================================================
# Required Configuration
# =============================================================================

# Database connection string (MySQL)
# Docker Compose default: mysql://oreader:oreader@db:3306/oreader?parseTime=true
# Local dev: mysql://oreader:oreader@tcp(localhost:3306)/oreader?charset=utf8mb4&parseTime=True&loc=Local
DATABASE_URL=mysql://oreader:oreader@tcp(localhost:3306)/oreader?charset=utf8mb4&parseTime=True&loc=Local

# JWT secret key for token signing
# MUST be at least 32 characters (256 bits)
# Generate with: openssl rand -base64 32
JWT_SECRET_KEY=your-secret-key-change-me-in-production-must-be-32-characters

# =============================================================================
# Server Configuration
# =============================================================================

# ENV: development or production (default: development)
ENV=development

# Server port (default: 8080)
PORT=8080

# Authentication settings
# JWT_ACCESS_TTL: Access token lifetime (default: 15m)
# JWT_REFRESH_TTL: Refresh token lifetime (default: 168h = 7 days)
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=168h

# RSS Feed Refresh settings
# REFRESH_INTERVAL: Background refresh interval (default: 15m)
REFRESH_INTERVAL=15m

# Rate Limiting
RATE_LIMIT_ENABLED=true
# RATE_LIMIT_REDIS_URL=redis://localhost:6379

# Logging
LOG_LEVEL=info

# =============================================================================
# OAuth Configuration (Optional)
# =============================================================================

# GitHub OAuth
# GITHUB_CLIENT_ID=your-github-client-id
# GITHUB_CLIENT_SECRET=your-github-client-secret
# GITHUB_CALLBACK_HOST=your-host:8080

# =============================================================================
# Paper Import Configuration (Optional)
# =============================================================================

# Paper converter gRPC service address
# Docker Compose: converter:50051
# Local dev: localhost:50051
PAPER_GRPC_ADDR=localhost:50051

# Directory for uploaded PDF files
PAPER_UPLOAD_DIR=uploads/papers

# Maximum PDF upload size in bytes (default: 52428800 = 50MB)
PAPER_MAX_UPLOAD_SIZE=52428800

# gRPC client timeout — OCR for large PDFs can take 30+ minutes (default: 30m)
PAPER_GRPC_TIMEOUT=30m

# =============================================================================
# Converter Service Configuration (Optional)
# =============================================================================

# LLM API key for metadata extraction and Markdown refinement
# LLM_API_KEY=your-api-key

# LLM API base URL (default: https://api.openai.com/v1)
# LLM_BASE_URL=https://api.openai.com/v1

# LLM model name (default: gpt-4o-mini)
# LLM_MODEL=gpt-4o-mini

# Converter gRPC server port (default: 50051)
# GRPC_PORT=50051

# =============================================================================
# Docker Compose Configuration
# =============================================================================

# Host IP for service binding (used in FRONTEND_URL)
HOST_IP=localhost

# MySQL credentials
MYSQL_ROOT_PASSWORD=rootpassword
OREADER_DB_PASSWORD=oreader

# Port mappings (change to avoid conflicts)
# DB_PORT=3306
# FRONTEND_PORT=5173
# GRPC_PORT=50051
# PMA_PORT=8081
# REDIS_PORT=6379

# Frontend dev server proxy target
# Docker: http://backend:8080 (internal DNS)
# Local: http://localhost:8080
# VITE_API_TARGET=http://localhost:8080

# Test database URL (for Go tests)
# TEST_DATABASE_URL=oreader:oreader@tcp(localhost:3306)/oreader_test?charset=utf8mb4&parseTime=True&loc=Local
