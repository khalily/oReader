# oReader Production Environment Configuration
# Copy this file to .env.prod and fill in secure values

# =============================================================================
# Required Configuration - MUST BE CHANGED
# =============================================================================

# Database connection string (MySQL for production)
DATABASE_URL=mysql://oreader:CHANGE_ME_PASSWORD@db:3306/oreader?parseTime=true

# JWT secret key for token signing
# MUST be at least 32 characters (256 bits)
# Generate with: openssl rand -base64 32
JWT_SECRET_KEY=CHANGE_ME_GENERATE_WITH_openssl_rand_-_base64_32

# =============================================================================
# Database Configuration
# =============================================================================

# MySQL root password (for database container)
MYSQL_ROOT_PASSWORD=CHANGE_ME_SECURE_ROOT_PASSWORD

# MySQL oreader user password
OREADER_DB_PASSWORD=CHANGE_ME_SECURE_OREADER_PASSWORD

# =============================================================================
# Server Configuration
# =============================================================================

# Server port (default: 8080)
PORT=8080

# Log level (debug, info, warn, error)
LOG_LEVEL=info

# =============================================================================
# Optional Configuration
# =============================================================================

# JWT Access Token TTL (default: 15m)
JWT_ACCESS_TTL=15m

# JWT Refresh Token TTL (default: 168h = 7 days)
JWT_REFRESH_TTL=168h

# Background Refresh Interval (default: 15m)
REFRESH_INTERVAL=15m

# =============================================================================
# Rate Limiting (Optional)
# =============================================================================

# Enable rate limiting
RATE_LIMIT_ENABLED=true

# Redis URL for distributed rate limiting (uncomment to use)
# RATE_LIMIT_REDIS_URL=redis://redis:6379

# =============================================================================
# GitHub OAuth (Optional - Reserved for future use)
# =============================================================================

# GITHUB_CLIENT_ID=your-github-client-id
# GITHUB_CLIENT_SECRET=your-github-client-secret
